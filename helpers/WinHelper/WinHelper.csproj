<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinHelper: programa de consola que habla con Windows por Notch: la sesión
    multimedia (lo que suena en Apple Music, Spotify, el navegador...), el
    volumen, las salidas de audio y el portapapeles (solo texto). Escribe una
    línea JSON por novedad en stdout y recibe órdenes por stdin.

    Compilar (desde la raíz del proyecto):
      npm run build:helper
    que equivale a:
      dotnet publish helpers/WinHelper -c Release -o helpers/WinHelper/publish
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- "windows10.0.19041.0" da acceso a las APIs de Windows (Windows.Media.Control) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No necesitamos datos de idiomas/culturas: el .exe es más ligero -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>WinHelper</AssemblyName>
    <RootNamespace>WinHelper</RootNamespace>

    <!-- Publicación: un único WinHelper.exe para Windows x64 que usa el .NET 8 instalado -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <Target Name="CopyWhisperRuntimesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WhisperNativeDlls Include="$(TargetDir)runtimes\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperNativeDlls)" DestinationFolder="$(PublishDir)runtimes\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
