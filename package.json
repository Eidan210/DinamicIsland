{
  "name": "notch",
  "productName": "Notch",
  "version": "0.10.0",
  "description": "Isla dinámica estilo iPhone para Windows 11, hecha con Electron.",
  "main": "main.js",
  "private": true,
  "author": "Eidan Cuadros",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:helper": "dotnet publish helpers/WinHelper -c Release -o helpers/WinHelper/publish",
    "pack": "npm run build:helper && electron-builder --win --dir",
    "dist": "npm run build:helper && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.eidancuadros.notch",
    "productName": "Notch",
    "files": [
      "main.js",
      "main/**/*",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "helpers/WinHelper/publish",
        "to": "WinHelper",
        "filter": [
          "WinHelper.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "simple-icons": "^16.36.0"
  }
}
